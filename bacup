<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#000000" />
  <meta name="description" content="AM Pro Toolkit — Modern Monochrome Edition" />
  <title>AM Pro Toolkit | 𝐱𝙈𝙎𝙃𝙖𝙤𝙢𝙞</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --bg: #000000;
      --panel: rgba(18, 18, 20, 0.65);
      --panel-hover: rgba(28, 28, 32, 0.75);
      --border: rgba(255, 255, 255, 0.12);
      --border-focus: rgba(255, 255, 255, 0.4);
      --text: #f4f4f5;
      --muted: #a1a1aa;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--text);
      background: 
        radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.08), transparent 50%),
        #000000;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Efek Grid Abstrak di Background */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    }

    /* Glassmorphism Utama */
    .glass {
      background: var(--panel);
      border: 1px solid var(--border);
      backdrop-filter: blur(30px) saturate(150%);
      -webkit-backdrop-filter: blur(30px) saturate(150%);
      box-shadow: 
        0 24px 48px rgba(0, 0, 0, 0.8),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: all .25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .glass-card:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.18);
    }

    input, select {
      width: 100%;
      color: #ffffff !important;
      background: rgba(10, 10, 12, 0.8) !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-radius: 14px !important;
      outline: none;
      transition: all .2s ease;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    input::placeholder {
      color: #52525b;
    }

    input:focus, select:focus {
      border-color: #ffffff !important;
      background: rgba(18, 18, 22, 0.95) !important;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08), 0 0 20px rgba(255, 255, 255, 0.05) !important;
    }

    select option {
      background: #121214;
      color: white;
    }

    /* Tombol Kustom */
    .btn {
      border-radius: 14px;
      font-weight: 600;
      transition: all .2s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: #ffffff;
      color: #000000;
      border: 1px solid #ffffff;
      box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
    }

    .btn-primary:hover {
      background: #e4e4e7;
      box-shadow: 0 6px 25px rgba(255, 255, 255, 0.35);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
    }

    /* Navigasi / Dock Style Baru */
    .nav-pill {
      position: relative;
      color: #71717a;
      transition: all .25s ease;
    }

    .nav-pill:hover {
      color: #d4d4d8;
    }

    .nav-pill.active {
      color: #000000;
      background: #ffffff;
      font-weight: 700;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    }

    .toast {
      transform: translate(-50%, 20px);
      opacity: 0;
      pointer-events: none;
      transition: all .3s cubic-bezier(0.16, 1, 0.3, 1);
      background: rgba(18, 18, 22, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(20px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.8), 0 0 20px rgba(255,255,255,0.1);
    }

    .toast.show {
      transform: translate(-50%, 0);
      opacity: 1;
    }

    .hidden {
      display: none !important;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade {
      animation: fadeIn .3s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  </style>
</head>

<body class="min-h-screen px-4 py-5 flex flex-col items-center justify-between">

  <!-- WRAPPER UTAMA -->
  <div class="w-full max-w-lg flex flex-col gap-5 my-auto">

    <!-- HEADER / KEPALA MINIMALIS -->
    <header class="glass rounded-[24px] p-4 flex items-center justify-between">
      <div class="flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-[16px] bg-white/10 border border-white/20 flex items-center justify-center text-white text-base shadow-[0_0_15px_rgba(255,255,255,0.1)]">
          <i class="fa-solid fa-cube"></i>
        </div>
        <div>
          <h1 class="font-bold text-[15px] tracking-tight text-white flex items-center gap-2">
            AM Pro Toolkit
            <span class="text-[9px] px-2 py-0.5 rounded-full bg-white/10 text-white border border-white/20 font-mono">v3.0</span>
          </h1>
          <p class="text-[11px] text-zinc-400 mt-0.5">𝐱𝙈𝙎𝙃𝙖𝙤𝙢𝙞 Enterprise System</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-white shadow-[0_0_10px_#ffffff] animate-pulse"></div>
        <span class="text-[11px] font-medium text-zinc-300 hidden sm:inline">Active</span>
      </div>
    </header>

    <!-- PANEL UTAMA DENGAN TATA LETAK BARU -->
    <main class="glass rounded-[28px] p-5 sm:p-6 flex flex-col gap-5">

      <!-- DASHBOARD / STATUS PANEL KECIL -->
      <div class="glass-card rounded-[20px] p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-[14px] bg-white text-black flex items-center justify-center font-bold text-sm shadow-[0_0_15px_rgba(255,255,255,0.3)]">
            A
          </div>
          <div>
            <div class="text-[13px] font-bold text-white" id="displayUsername">Administrator</div>
            <div class="text-[10px] text-zinc-400 flex items-center gap-1 mt-0.5">
              <i class="fa-solid fa-shield-halved text-[9px]"></i> Unlimited Access Mode
            </div>
          </div>
        </div>
        <div class="text-right">
          <div class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold">Status</div>
          <div class="text-[11px] font-mono text-white font-semibold mt-0.5">ONLINE</div>
        </div>
      </div>

      <!-- NAVIGASI TAB PILL BERGAYA ISLAND -->
      <div class="grid grid-cols-3 gap-1.5 p-1 bg-white/[0.03] border border-white/10 rounded-[18px]">
        <button id="tabSend" onclick="switchTab('send')" class="nav-pill active py-2.5 rounded-[14px] text-[11px] font-semibold transition-all">
          <i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i> Aktivasi
        </button>
        <button id="tabBulk" onclick="switchTab('bulk')" class="nav-pill py-2.5 rounded-[14px] text-[11px] font-semibold transition-all">
          <i class="fa-solid fa-layer-group mr-1.5"></i> Bulk
        </button>
        <button id="tabInbox" onclick="switchTab('inbox')" class="nav-pill py-2.5 rounded-[14px] text-[11px] font-semibold transition-all">
          <i class="fa-solid fa-inbox mr-1.5"></i> Inbox
        </button>
      </div>

      <!-- KONTEN TAB: AKTIVASI -->
      <div id="contentSend" class="animate-fade space-y-4">
        <div>
          <div class="text-[10px] uppercase font-bold tracking-widest text-zinc-400 mb-1">Secure Protocol</div>
          <h2 class="text-[16px] font-bold text-white">Aktivasi Alight Motion</h2>
          <p id="flowInstruction" class="text-[11px] text-zinc-400 mt-1 leading-relaxed">
            Kirimkan magic link ke alamat email aktif Anda untuk memulai proses sinkronisasi.
          </p>
        </div>

        <div id="stepEmailBox" class="space-y-3">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-zinc-500">
              <i class="fa-regular fa-envelope"></i>
            </span>
            <input id="inputEmail" type="email" placeholder="nama@domain.com" class="pl-11 pr-4 py-3.5 text-[12px]" />
          </div>
          <button onclick="handleSendMagicLink()" class="btn btn-primary w-full py-3.5 text-[12px] flex items-center justify-center gap-2">
            <span>Kirim Magic Link</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </button>
        </div>

        <div id="stepVerifyBox" class="hidden space-y-3">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-zinc-500">
              <i class="fa-solid fa-link"></i>
            </span>
            <input id="inputLink" type="text" placeholder="Tempel link verifikasi https://..." class="pl-11 pr-4 py-3.5 text-[12px]" />
          </div>
          <div class="grid grid-cols-[1fr_auto] gap-2">
            <button onclick="handleVerifyMagicLink()" class="btn btn-primary py-3.5 text-[12px] font-bold">
              Verifikasi & Eksekusi
            </button>
            <button onclick="resetInjectFlow()" class="btn btn-secondary px-4 text-white">
              <i class="fa-solid fa-rotate-left"></i>
            </button>
          </div>
        </div>

        <div id="sendResult" class="glass-card hidden p-4 rounded-[16px] text-[11px] border border-white/10"></div>
      </div>

      <!-- KONTEN TAB: BULK -->
      <div id="contentBulk" class="animate-fade space-y-4 hidden">
        <div>
          <div class="text-[10px] uppercase font-bold tracking-widest text-zinc-400 mb-1">Batch Automation</div>
          <h2 class="text-[16px] font-bold text-white">Bulk Generator</h2>
          <p class="text-[11px] text-zinc-400 mt-1">Buat banyak token akun premium secara simultan dengan cepat.</p>
        </div>

        <div class="space-y-3">
          <div>
            <label class="block text-[10px] uppercase font-bold text-zinc-400 mb-1.5">Jumlah Akun (1 - 100)</label>
            <input id="inputBulkAmount" type="number" min="1" max="100" value="5" class="px-4 py-3.5 text-[12px]" />
          </div>
          <button onclick="runBulkInject()" class="btn btn-primary w-full py-3.5 text-[12px]">
            Mulai Generate Bulk
          </button>
        </div>

        <div id="bulkResult" class="glass-card hidden p-4 rounded-[16px] text-[11px] max-h-48 overflow-y-auto font-mono"></div>
      </div>

      <!-- KONTEN TAB: INBOX -->
      <div id="contentInbox" class="animate-fade space-y-4 hidden">
        <div>
          <div class="text-[10px] uppercase font-bold tracking-widest text-zinc-400 mb-1">Mail Scanner</div>
          <h2 class="text-[16px] font-bold text-white">Pindai Kotak Masuk</h2>
          <p class="text-[11px] text-zinc-400 mt-1">Ambil link verifikasi langsung dari mail server secara otomatis.</p>
        </div>

        <div class="space-y-3">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-zinc-500">
              <i class="fa-solid fa-at"></i>
            </span>
            <input id="inputInboxEmail" type="email" placeholder="email@tempmail.com" class="pl-11 pr-4 py-3.5 text-[12px]" />
          </div>
          <button onclick="runInboxCheck()" class="btn btn-primary w-full py-3.5 text-[12px] flex items-center justify-center gap-2">
            <i class="fa-solid fa-radar"></i>
            <span>Pindai Pesan Masuk</span>
          </button>
        </div>

        <div id="inboxNotice" class="hidden p-3 rounded-[12px] text-[11px] bg-white/5 border border-white/10 text-zinc-300"></div>
        <div id="inboxResult" class="space-y-2.5 max-h-48 overflow-y-auto"></div>
      </div>

    </main>

    <!-- FOOTER -->
    <footer class="text-center">
      <p class="text-[11px] text-zinc-500 font-medium">
        AM Pro Toolkit <span class="mx-1.5 text-zinc-700">•</span> Secure Monochrome <span class="mx-1.5 text-zinc-700">•</span> 𝐱𝙈𝙎𝙃𝙖𝙤𝙢𝙞
      </p>
    </footer>

  </div>

  <!-- TOAST NOTIFIKASI -->
  <div id="toast" class="toast fixed z-50 bottom-6 left-1/2 rounded-[16px] px-5 py-3 text-[11px] text-white shadow-2xl max-w-[calc(100vw-32px)]"></div>

<script>
  let activeInjectEmail = "";

  function showToast(message) {
    const toast = document.getElementById("toast");
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => toast.classList.remove("show"), 3000);
  }

  function switchTab(tab) {
    const contents = {
      send: document.getElementById("contentSend"),
      bulk: document.getElementById("contentBulk"),
      inbox: document.getElementById("contentInbox")
    };

    const tabs = {
      send: document.getElementById("tabSend"),
      bulk: document.getElementById("tabBulk"),
      inbox: document.getElementById("tabInbox")
    };

    Object.values(contents).forEach(el => el.classList.add("hidden"));
    Object.values(tabs).forEach(el => el.classList.remove("active"));

    contents[tab].classList.remove("hidden");
    tabs[tab].classList.add("active");
  }

  async function handleSendMagicLink() {
    const email = document.getElementById("inputEmail").value.trim();

    if (!email || !email.includes("@")) {
      return showToast("Masukkan format email yang valid.");
    }

    showToast("Mengirim magic link...");

    try {
      const res = await fetch("/api/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        const text = await res.text();
        throw new Error(text || "Terjadi kesalahan pada server.");
      }

      const json = await res.json();

      if (!res.ok || json.status === false) {
        throw new Error(json.message || "Gagal mengirim magic link.");
      }

      activeInjectEmail = email;

      document.getElementById("stepEmailBox").classList.add("hidden");
      document.getElementById("stepVerifyBox").classList.remove("hidden");
      document.getElementById("flowInstruction").textContent =
        `Magic link dikirim ke ${email}. Masukkan link verifikasi Anda di bawah ini.`;

      showToast("Magic link berhasil dikirim.");
    } catch (err) {
      showToast(err.message || "Koneksi gagal.");
    }
  }

  async function handleVerifyMagicLink() {
    const link = document.getElementById("inputLink").value.trim();

    if (!link) return showToast("Masukkan link verifikasi.");

    showToast("Memverifikasi data...");

    let success = false;
    let resultMessage = "";

    try {
      const res = await fetch("/api/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: activeInjectEmail,
          link
        })
      });

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        const text = await res.text();
        throw new Error(text || "Terjadi kesalahan pada server.");
      }

      const json = await res.json();

      success = res.ok && json.status !== false;
      resultMessage = json.message || "Verifikasi berhasil.";

      const result = document.getElementById("sendResult");
      result.innerHTML = `
        <div class="font-bold ${success ? "text-white" : "text-zinc-400"}">
          ${success ? "STATUS: BERHASIL" : "STATUS: GAGAL"}
        </div>
        <div class="text-[11px] text-zinc-300 mt-1 leading-relaxed">
          ${escapeHtml(resultMessage)}
        </div>
      `;
      result.classList.remove("hidden");
    } catch (err) {
      success = false;
      showToast(err.message || "Kesalahan jaringan.");
    }

    if (success) {
      showToast("Verifikasi berhasil.");
      setTimeout(resetInjectFlow, 900);
    } else {
      showToast("Verifikasi gagal.");
    }
  }

  function resetInjectFlow() {
    activeInjectEmail = "";

    document.getElementById("inputEmail").value = "";
    document.getElementById("inputLink").value = "";

    document.getElementById("stepVerifyBox").classList.add("hidden");
    document.getElementById("stepEmailBox").classList.remove("hidden");

    document.getElementById("flowInstruction").textContent =
      "Kirimkan magic link ke alamat email aktif Anda untuk memulai proses sinkronisasi.";

    document.getElementById("sendResult").classList.add("hidden");
  }

  async function runBulkInject() {
    const amount = Number(document.getElementById("inputBulkAmount").value);

    if (!amount || amount < 1 || amount > 100) {
      return showToast("Jumlah harus di antara 1 - 100.");
    }

    showToast("Memproses bulk generator...");

    let success = false;
    let resultMessage = "";

    try {
      const res = await fetch("/api/bulk", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount })
      });

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        const text = await res.text();
        throw new Error(text || "Terjadi kesalahan pada server.");
      }

      const json = await res.json();

      success = res.ok && json.status !== false;
      resultMessage = json.message || JSON.stringify(json, null, 2);

      const result = document.getElementById("bulkResult");

      result.innerHTML = `
        <div class="font-bold ${success ? "text-white" : "text-zinc-400"}">
          ${success ? "BULK GENERATE SUCCESS" : "BULK GENERATE FAILED"}
        </div>
        <pre class="whitespace-pre-wrap text-[10px] text-zinc-300 mt-1">${escapeHtml(resultMessage)}</pre>
      `;

      result.classList.remove("hidden");
    } catch (err) {
      success = false;
      showToast(err.message || "Koneksi gagal.");
    }

    if (success) {
      showToast("Proses bulk selesai.");
    } else {
      showToast("Proses bulk gagal.");
    }
  }

  async function runInboxCheck() {
    const email = document.getElementById("inputInboxEmail").value.trim();
    const notice = document.getElementById("inboxNotice");
    const container = document.getElementById("inboxResult");

    if (!email) return showToast("Masukkan alamat email.");

    notice.textContent = "Memindai kotak masuk...";
    notice.classList.remove("hidden");

    container.innerHTML = "";

    try {
      const res = await fetch("/api/inbox", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });

      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        const text = await res.text();
        throw new Error(text || "Terjadi kesalahan pada server.");
      }

      const json = await res.json();

      if (!res.ok || json.status === false) {
        throw new Error(json.message || "Gagal memindai inbox.");
      }

      notice.textContent = "Pemindaian kotak masuk selesai.";

      const messages = json.data?.messages || [];

      if (!messages.length) {
        container.innerHTML =
          '<div class="text-[11px] text-zinc-500 p-4 text-center">Tidak ada pesan ditemukan.</div>';
        return;
      }

      messages.forEach(msg => {
        const card = document.createElement("div");
        card.className =
          "glass-card p-3.5 rounded-[14px] space-y-2.5";

        const subject = msg.subject || "Tanpa Subjek";
        const link = msg.login_url || "";

        card.innerHTML = `
          <div class="text-[11px] font-bold text-white">${escapeHtml(subject)}</div>
          ${
            link
              ? `
                <div class="p-2.5 rounded-[10px] bg-black/40 border border-white/10 text-zinc-300 text-[10px] break-all font-mono">
                  ${escapeHtml(link)}
                </div>
                <button class="btn btn-primary w-full py-2.5 text-[10px] font-bold">
                  Salin Link Verifikasi
                </button>
              `
              : `
                <div class="text-[10px] text-zinc-500">
                  Link verifikasi belum tersedia.
                </div>
              `
          }
        `;

        if (link) {
          card.querySelector("button").addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(link);
              showToast("Link berhasil disalin.");
            } catch {
              showToast("Gagal menyalin link.");
            }
          });
        }

        container.appendChild(card);
      });
    } catch (err) {
      notice.textContent = err.message;
    }
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
</script>
</body>
</html>